# ── Assistify API — environment template ─────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# Server
NODE_ENV=development
PORT=5050
CLIENT_URL=http://localhost:5173

# Database — local MongoDB in dev, MongoDB Atlas in production
MONGO_URI=mongodb://127.0.0.1:27017/assistify

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ── Email (invitation links) ─────────────────────────────────────────
# LEAVE THESE BLANK for development. With no SMTP_HOST the server sends
# through Ethereal — a sandbox inbox that delivers to nobody and prints a
# preview URL in the terminal. The full invite → activate flow works with
# zero setup and no credentials in the repo.
#
# To send REAL email from Gmail:
#   1. Google Account → Security → turn on 2-Step Verification
#   2. Security → App passwords → generate one for "Mail"
#   3. Paste the 16-character password below (NOT your Gmail password)
# Gmail blocks plain account passwords; only an App Password works.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# MAIL_FROM="Assistify <you@gmail.com>"

# --- AI assistant ----------------------------------------------------------
# Two providers, tried in this order. Either alone is enough to run the chat;
# configuring both means a rate limit on one is covered by the other.
#
# GROQ is the primary. Its free tier allows thousands of requests a day where
# Gemini's allows about twenty, and it needs no credit card.
#   https://console.groq.com/keys
GROQ_API_KEY=

# GEMINI is the chat fallback, and is required for Company Policies regardless
# of which provider answers — document retrieval embeds through it.
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Groq model (hosted names get retired without notice).
# List what your key can reach:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# GROQ_MODEL=qwen/qwen3.6-27b

# Optional: override the embedding model used by Company Policies.
# WARNING: changing this invalidates every stored vector — existing documents
# must be deleted and re-uploaded, and MIN_SIMILARITY re-measured.
# EMBEDDING_MODEL=gemini-embedding-2
