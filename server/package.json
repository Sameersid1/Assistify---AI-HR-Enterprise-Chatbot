{
  "name": "assistify-server",
  "version": "0.1.0",
  "private": true,
  "description": "Assistify API — AI-Powered HR Assistant (backend)",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "inspect:db": "tsx src/scripts/inspect-db.ts",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "create-admin:prod": "tsx src/scripts/prod.ts create-admin",
    "inspect:db:prod": "tsx src/scripts/prod.ts inspect-db",
    "test:permissions": "tsx src/scripts/permission-matrix.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "npm run typecheck && npm run test:llm && npm run test:audience",
    "test:llm": "tsx scripts/verify-llm.mjs",
    "test:audience": "tsx scripts/verify-audience.mjs",
    "test:ops": "tsx scripts/verify-ops.mjs",
    "test:password": "tsx scripts/verify-password.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^9.0.5",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
